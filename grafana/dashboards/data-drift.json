{
  "uid": "mlops-data-drift",
  "title": "ML Observability - Data Drift",
  "tags": [
    "mlops",
    "drift",
    "xgboost"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Numeric Feature PSI",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "ml_feature_drift_score{method=\"psi\"}",
          "refId": "A",
          "legendFormat": "{{feature}}",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 2,
      "title": "Categorical Drift (TVD)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "ml_feature_drift_score{method=\"tvd\"}",
          "refId": "A",
          "legendFormat": "{{feature}}"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Unique Orders in Monitoring Window",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "ml_drift_sample_count",
          "refId": "A",
          "legendFormat": "{{feature}}"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Missing Feature Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "ml_feature_missing_rate",
          "refId": "A",
          "legendFormat": "{{feature}}"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
