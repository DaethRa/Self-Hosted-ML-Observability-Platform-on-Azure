{
  "uid": "mlops-model-performance",
  "title": "ML Observability - Model Performance",
  "tags": [
    "mlops",
    "performance",
    "xgboost"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
